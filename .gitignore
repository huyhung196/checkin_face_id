# =======================================================
# 1. DỮ LIỆU CÁ NHÂN, KHUÔN MẶT & ẢNH (BẢO MẬT TUYỆT ĐỐI)
# =======================================================
# Bỏ qua toàn bộ ảnh chụp khuôn mặt, avatar nhân viên, ảnh check-in
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
**/uploads/**

# Bỏ qua cơ sở dữ liệu SQLite (chứa thông tin nhân viên, vector khuôn mặt)
backend/checkin.db
*.db
*.sqlite
*.sqlite3

