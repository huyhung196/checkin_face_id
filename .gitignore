# 2. PYTHON & MÔI TRƯỜNG ẢO
# =======================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.log

# =======================================================
# 3. NODE & FRONTEND BUILD
# =======================================================
node_modules/
frontend/node_modules/
dist/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =======================================================
# 4. MÔI TRƯỜNG & KHÓA BẢO MẬT (ENV)
# =======================================================
.env
.env.local
.env.*.local
*.env

